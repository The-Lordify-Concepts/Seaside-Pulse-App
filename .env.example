# --- Frontend (Vite / Vercel) ---
# After API is live, set this on Vercel and redeploy the frontend:
VITE_API_URL=https://your-api-host.onrender.com

# Local:
# VITE_API_URL=http://localhost:3001

# --- API server ---
PORT=3001
NODE_ENV=production
PULSE_SESSION_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=https://seaside-pulse-staging.vercel.app
# DATA_DIR=/data

# Set true only while testing demo accounts on a live API
# ALLOW_DEMO_LOGIN=false
